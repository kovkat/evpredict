{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --enable-source-maps ./dist/server.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./build.mjs && node --test test/*.test.mjs",
    "test:coverage": "API_ENTRY=../src/index.ts node --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/data/**' --test test/*.test.mjs"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "@workspace/energy": "workspace:*",
    "zod": "catalog:",
    "@electric-sql/pglite": "^0.3.16"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
